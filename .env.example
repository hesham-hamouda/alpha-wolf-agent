# Alpha Wolf Agent — Frontend (.env template)
# Copy this to `.env` and adjust values as needed

# ============================================================================
# Body infrastructure
# ============================================================================
BODY_ROOT=E:\Projects and systems managed by the team of experts\Alpha Wolf Agent\body
CHROMADB_DIR=${BODY_ROOT}/knowledge_graph/chromadb
NETWORKX_DIR=${BODY_ROOT}/knowledge_graph/networkx
STATE_DB=${BODY_ROOT}/memory/state.db
ZVEC_DIR=${BODY_ROOT}/memory/embeddings/zvec

# ============================================================================
# Inference (llama.cpp server — must be running)
# ============================================================================
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_API_KEY=                    # empty for local llama.cpp
# FIX 2026-10-06: original `alpha-wolf-agent` model is BROKEN (llama-server exit status 1).
# Must use the working `alpha-wolf-agent-v8` rebuild instead.
LLAMACPP_MODEL=alpha-wolf-agent-v8

# ============================================================================
# Embedding model (Ollama local)
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================================================
# Chainlit (Frontend)
# ============================================================================
CHAINLIT_AUTH_SECRET=                # run: chainlit create-secret
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# ============================================================================
# FastAPI (Backend)
# ============================================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=E:\Projects and systems managed by the team of experts\Alpha Wolf Agent\body\logs\alpha_wolf.log

# ============================================================================
# Web Search Engine (optional professional providers — keyless mode works)
# Set any key to upgrade that provider to first priority. Leave empty = skip.
# ============================================================================
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ============================================================================
# Projects folder (OUTSIDE the body — body stays clean for knowledge/skills)
# ============================================================================
PROJECTS_ROOT=D:\A\Applications under development\TESTS

# ============================================================================
# Generation policy (FIX 2026-09-26 — Round 13)
# The served model is a THINKING model: reasoning shares the max_tokens
# budget, so a small budget returns an EMPTY answer. The backend enforces a
# floor and retries once with reasoning off. It also trims the oldest turns
# (never the system rules) to the context the model actually runs with —
# read live from Ollama `PARAMETER num_ctx` (see data/Alpha_Wolf_Modelfile).
# ============================================================================
AGENT_MIN_TOKENS=2048
# reasoning_effort: leave empty = model default (visible thinking panel).
# Set to "none" for the fastest, most deterministic tool-first answers.
AGENT_REASONING_EFFORT=
# Retry once with reasoning disabled when a stream yields no visible answer.
AGENT_EMPTY_RETRY=1
# Used only if Ollama cannot be asked for its num_ctx (fail-safe: trim early).
AGENT_CONTEXT_FALLBACK=8192

# ============================================================================
# Vision (local eyes — small vision model via Ollama)
# ============================================================================
VISION_MODEL=moondream